# ─── eShoppingCentre — Produção ───
# Copia este ficheiro para .env e preenche os valores

# Domínio
DOMAIN=e-shoppingcentre.com

# Django
SECRET_KEY=substitui-por-uma-chave-segura-de-50-caracteres
DEBUG=False
ALLOWED_HOSTS=e-shoppingcentre.com,www.e-shoppingcentre.com

# Database
DB_NAME=eshoppingcentre
DB_USER=eshopping
DB_PASSWORD=substitui-por-password-forte-de-producao

# Firebase
FIREBASE_SERVICE_ACCOUNT_KEY=credentials/firebase-adminsdk.json

# Firebase Web (passado ao build do frontend via docker-compose)
# IMPORTANTE: authDomain deve ser o domínio do PROJETO (firebaseapp.com),
# porque o Firebase Hosting serve as rotas /__/auth/handler e /__/auth/iframe.
# ⚠️ NÃO usar e-shoppingcentre.com aqui — isso causa 404 em /__/auth/handler.
# ⚠️ Após alterar o authDomain, reconstruir o frontend SEM cache:
#      docker compose build --no-cache frontend && docker compose up -d frontend
# ⚠️ Adicionar o domínio real em: Firebase Console → Authentication → Settings
#      → Authorized domains (ex: e-shoppingcentre.com e www.e-shoppingcentre.com)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=eshoppingcentre-1cc68.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=eshoppingcentre-1cc68
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=eshoppingcentre-1cc68.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1017529752588
NEXT_PUBLIC_FIREBASE_APP_ID=1:1017529752588:web:...

# AWS S3 / Digital Ocean Spaces (media files)
AWS_ACCESS_KEY_ID=DO00...
AWS_SECRET_ACCESS_KEY=...
AWS_STORAGE_BUCKET_NAME=eshoppingcentre-media
AWS_S3_REGION_NAME=ams3
AWS_S3_ENDPOINT_URL=https://ams3.digitaloceanspaces.com

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (SendGrid / SMTP)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SG....
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@e-shoppingcentre.com

# Frontend URL
FRONTEND_URL=https://e-shoppingcentre.com

# Firebase Client (frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBDT4Q4Lt2KFnmOsXbQev_as3GaeUPGdQk
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=eshoppingcentre-1cc68.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=eshoppingcentre-1cc68
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=eshoppingcentre-1cc68.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1017529752588
NEXT_PUBLIC_FIREBASE_APP_ID=1:1017529752588:web:fc57ffd6f0bbafc8fb6229
