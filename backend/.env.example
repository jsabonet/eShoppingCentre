SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000

DB_NAME=eshoppingcentre
DB_USER=eshopping
DB_PASSWORD=eshopping123
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ─── ZumboPay (gateway de pagamento) — https://zumbopay.com/documentacao ───
ZUMBOPAY_BASE_URL=https://zumbopay.com/api/public/v1
# Merchant ID da conta (Painel → Programadores)
ZUMBOPAY_MERCHANT_ID=
# API Key: zk_live_… (produção) ou zk_test_… (teste)
ZUMBOPAY_API_KEY=
# Webhook Secret: valida o cabeçalho x-zumbopay-signature.
# Obrigatório em produção — sem ele o webhook recusa todos os pedidos (503).
# Em DEBUG é ignorado com um aviso, para o desenvolvimento local funcionar.
ZUMBOPAY_WEBHOOK_SECRET=
# wallet_id (UUID) da carteira de cada método — obrigatório para cobrar.
# Obtém-se com GET /merchant/validate ou GET /wallets. Um método sem wallet_id
# não pode ser cobrado: se o cliente o escolher no checkout, o pedido devolve
# erro em vez de cobrar. Só ofereça no UI os métodos que têm carteira.
ZUMBOPAY_WALLET_MPESA=
ZUMBOPAY_WALLET_EMOLA=
ZUMBOPAY_WALLET_CARD=
ZUMBOPAY_WALLET_MKESH=
# URL pública absoluta do webhook (opcional; deriva de BACKEND_URL se vazia).
# Deve ser registada no Painel ZumboPay → Programadores, e TEM de terminar em
# /api/v1/payments/webhook/zumbopay/ — registar só o domínio faz o gateway
# entregar num 404 e nenhum pagamento é confirmado pelo caminho normal.
# Confirmar com GET /api/v1/payments/gateway/ (campo `webhook_url_ok`).
ZUMBOPAY_WEBHOOK_URL=
# Reconciliação de pagamentos (rede de segurança para webhooks perdidos)
ZUMBOPAY_RECONCILE_MIN_AGE_MINUTES=5
ZUMBOPAY_RECONCILE_MAX_AGE_HOURS=48
ZUMBOPAY_RECONCILE_BATCH=50

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=

# ─── Email (Resend) ───
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=suporte@e-shoppingcentre.com
EMAIL_LOGO_URL=https://e-shoppingcentre.com/icon.png
SITE_URL=https://e-shoppingcentre.com
